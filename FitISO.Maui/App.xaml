<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FitISO.Maui"
              xmlns:converters="clr-namespace:FitISO.Maui.Converters"
             x:Class="FitISO.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/AccentThemes/Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:UtcToLocalDateConverter x:Key="DateConverter" />
            <converters:UtcToLocalTimeConverter x:Key="TimeConverter"/>
            <converters:NullableDoubleConverter x:Key="NullableDoubleConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
