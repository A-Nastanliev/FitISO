<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

	<ImageButton
        android:id="@+id/widget_start_button"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:scaleType="center"
        android:background="@drawable/widget_circle_button_background"
        android:src="@drawable/ic_play_arrow"
        android:contentDescription="@null" />

	<TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerVertical="false"
        android:layout_toStartOf="@id/widget_start_button"
        android:layout_marginEnd="12dp"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:gravity="start|center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Favourite Workout" />

	<ListView
        android:id="@+id/widget_exercise_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_title"
        android:layout_marginTop="6dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

	<TextView
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:padding="4dp"
        android:visibility="gone"
        android:text="Mark a favourite template in FitISO to start it here" />

</RelativeLayout>
