<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitISO.Maui.Views.ExerciseView"
             xmlns:vm="clr-namespace:FitISO.Maui.Models"
             x:DataType="vm:Exercise"
             x:Name="Root">

    <Border Style="{StaticResource SectionCard}" Padding="20,10">
        <Label HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Start" FontSize="Small" TextColor="White"
            Text="{Binding Name}"/>
    </Border>
</ContentView>
