<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FitISO.Maui.Models"
             xmlns:mhr="http://mhrastegari.com/progressring"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
             x:Class="FitISO.Maui.Views.SettingsPage">

    <Shell.TitleView>
        <Label Text="Settings" FontSize="Medium" FontAttributes="Bold" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
    </Shell.TitleView>

    <ScrollView VerticalScrollBarVisibility="Never" HorizontalScrollBarVisibility="Never" Padding="0,0,0,40">
        <VerticalStackLayout Padding="24" Spacing="16">

            <VerticalStackLayout x:Name="AccentSection" Spacing="16">
                <VerticalStackLayout Spacing="8">
                    <Label
                     Text="Appearance"
                     FontSize="Medium"
                     FontAttributes="Bold" />

                    <Label
                     Text="Pick an accent color."
                     FontSize="Small"
                     TextColor="{DynamicResource Gray500}" />
                </VerticalStackLayout>

                <CollectionView ItemsSource="{Binding AccentThemes}" SelectedItem="{Binding SelectedAccentTheme, Mode=TwoWay}"
                 SelectionMode="Single" HorizontalOptions="Fill" VerticalScrollBarVisibility="Never" HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="6" HorizontalItemSpacing="12" VerticalItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AccentTheme">
                            <Grid WidthRequest="44" HeightRequest="44">
                                <Ellipse Fill="{DynamicResource Gray900}" WidthRequest="44" HeightRequest="44"
                                 Stroke="{DynamicResource Gray600}" StrokeThickness="2"
                                 x:Name="Ring"/>
                                <Ellipse Fill="{Binding Swatch}" WidthRequest="30" HeightRequest="30"
                                 HorizontalOptions="Center" VerticalOptions="Center"/>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter TargetName="Ring" Property="Ellipse.Stroke" Value="{StaticResource White}" />
                                                    <Setter TargetName="Ring" Property="BackgroundColor" Value="Transparent"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray700}" Margin="0,8"/>

            <VerticalStackLayout x:Name="BackupSection" Spacing="16">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Backup &amp; Restore"
                        FontSize="Medium"
                        FontAttributes="Bold" />

                    <Label
                        Text="Export a backup of your data or import a previously exported backup. Importing will replace all current data and close the app."
                        FontSize="Small" HorizontalTextAlignment="Justify"
                        TextColor="{DynamicResource Gray500}" />
                </VerticalStackLayout>

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <Button
                        Text="Export Database" CornerRadius="24"
                        Command="{Binding ExportDatabaseCommand}"
                        IsEnabled="{Binding IsNotBusy}" FontSize="Small">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{DynamicResource Gray500}" />
                                            <Setter Property="Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{DynamicResource Gray500}" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>

                    <Button
                        Text="Import Database" CornerRadius="24" Grid.Column="1"
                        Command="{Binding ImportDatabaseCommand}"
                        IsEnabled="{Binding IsNotBusy}" FontSize="Small">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{DynamicResource DeleteColor}" />
                                            <Setter Property="Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{DynamicResource DeleteColor}" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Button>
                </Grid>

                <Label
                    FontSize="Small"
                    HorizontalOptions="Center"
                    TextColor="{DynamicResource Gray500}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding HasLastBackup}" Value="True">
                            <Setter Property="Text" Value="{Binding LastBackupUtc, Converter={StaticResource DateConverter}, StringFormat='Last backup: {0}'}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding HasLastBackup}" Value="False">
                            <Setter Property="Text" Value="No backup yet" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray700}" Margin="0,8"/>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label
                            Text="Auto-save"
                            FontSize="Medium" />
                        <Label
                            Text="Silently backs up your database to Downloads when a workout finishes."
                            FontSize="Small"  HorizontalTextAlignment="Justify"
                            TextColor="{DynamicResource Gray500}" />
                    </VerticalStackLayout>
                    <Switch
                        Grid.Column="1" VerticalOptions="Center" OffColor="{DynamicResource Gray700}"
                        IsToggled="{Binding AutoSaveEnabled, Mode=TwoWay}"
                        OnColor="{DynamicResource Gray300}"
                        ThumbColor="{StaticResource White}" />
                </Grid>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray700}" Margin="0,8"/>

            <VerticalStackLayout x:Name="WorkoutSettingsSection" Spacing="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Workout Layout" FontSize="Medium" />
                    <Label
                        Text="Choose how the workout stopwatch, progress bar and rest stopwatch are shown during your workout."
                        FontSize="Small" HorizontalTextAlignment="Justify"
                        TextColor="{DynamicResource Gray500}" />
                </VerticalStackLayout>

                <CollectionView ItemsSource="{Binding LayoutOptions}" SelectedItem="{Binding SelectedLayoutOption, Mode=TwoWay}"
                    SelectionMode="Single" VerticalScrollBarVisibility="Never" HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:WorkoutLayoutOption">
                            <Border HeightRequest="120" StrokeShape="RoundRectangle 16" StrokeThickness="2"
                                Stroke="{DynamicResource Gray600}" BackgroundColor="{DynamicResource Gray900}">
                                <VerticalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Grid HeightRequest="56" WidthRequest="72">
                                        <VerticalStackLayout Spacing="5" VerticalOptions="Center" HorizontalOptions="Center">
                                            <VerticalStackLayout.Triggers>
                                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Layout}"
                                                    Value="{x:Static models:WorkoutLayout.Ring}">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Layout}"
                                                    Value="{x:Static models:WorkoutLayout.CompactBar}">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Layout}"
                                                    Value="{x:Static models:WorkoutLayout.Segmented}">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </VerticalStackLayout.Triggers>
                                            <Border WidthRequest="24" HeightRequest="7" HorizontalOptions="Start"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 2"
                                                BackgroundColor="{DynamicResource Gray300}" />
                                            <Border WidthRequest="72" HeightRequest="12" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6" BackgroundColor="{DynamicResource Gray500}" />
                                            <Border WidthRequest="72" HeightRequest="12" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6" BackgroundColor="{DynamicResource Gray500}" />
                                        </VerticalStackLayout>
                                        <Grid WidthRequest="56" HeightRequest="56" HorizontalOptions="Center" IsVisible="False">
                                            <Grid.Triggers>
                                                <DataTrigger TargetType="Grid" Binding="{Binding Layout}"
                                                    Value="{x:Static models:WorkoutLayout.Ring}">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </Grid.Triggers>
                                            <mhr:ProgressRing WidthRequest="56" HeightRequest="56"
                                                HorizontalOptions="Center" VerticalOptions="Center"
                                                StrokeThickness="5" Progress="0.4"
                                                ProgressColor="{DynamicResource Gray300}"
                                                TrackColor="{DynamicResource Gray600}"
                                                InputTransparent="True" />
                                            <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True">
                                                <Border WidthRequest="28" HeightRequest="9" StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 3" BackgroundColor="{DynamicResource Gray500}" />
                                                <Border WidthRequest="16" HeightRequest="5" StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 2" BackgroundColor="{DynamicResource Gray500}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Border WidthRequest="72" HeightRequest="36" HorizontalOptions="Center" VerticalOptions="Center"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="0"
                                            BackgroundColor="{DynamicResource Gray700}" IsVisible="False" InputTransparent="True">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Layout}"
                                                    Value="{x:Static models:WorkoutLayout.CompactBar}">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Grid RowDefinitions="*,6">
                                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Padding="8,0">
                                                    <Border Grid.Column="0" WidthRequest="20" HeightRequest="8" HorizontalOptions="Start"
                                                        StrokeThickness="0" StrokeShape="RoundRectangle 2" BackgroundColor="{DynamicResource Gray500}" />
                                                    <Border Grid.Column="1" WidthRequest="12" HeightRequest="6"
                                                        StrokeThickness="0" StrokeShape="RoundRectangle 2" BackgroundColor="{DynamicResource Gray500}" />
                                                </Grid>
                                                <Border Grid.Row="1" WidthRequest="44" HeightRequest="6" HorizontalOptions="Start"
                                                    StrokeThickness="0" BackgroundColor="{DynamicResource Gray300}" />
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Spacing="5" WidthRequest="72" VerticalOptions="Center" HorizontalOptions="Center"
                                            IsVisible="False" InputTransparent="True">
                                            <VerticalStackLayout.Triggers>
                                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Layout}"
                                                    Value="{x:Static models:WorkoutLayout.Segmented}">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </VerticalStackLayout.Triggers>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="5" HeightRequest="26">
                                                <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{DynamicResource Gray500}" />
                                                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{DynamicResource Gray500}" />
                                            </Grid>
                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 5"
                                                BackgroundColor="Transparent" Padding="0" HeightRequest="10">
                                                <progressBar:SfLinearProgressBar Minimum="0" Maximum="4" Progress="3"
                                                    SegmentCount="4" SegmentGapWidth="3"
                                                    TrackHeight="10" ProgressHeight="10"
                                                    TrackCornerRadius="0" ProgressCornerRadius="0"
                                                    AnimationDuration="0" InputTransparent="True"
                                                    BackgroundColor="Transparent"
                                                    TrackFill="{DynamicResource Gray600}"
                                                    ProgressFill="{DynamicResource Gray300}" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Label Text="{Binding Title}" FontSize="Small" HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="Background" Value="{DynamicResource Gray900}"/>
                                                    <Setter Property="Stroke" Value="{StaticResource White}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray700}" Margin="0,8"/>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label
                            Text="Progress Card" FontSize="Medium" />
                        <Label
                            Text="Show a card with your set completion progress during your workout."
                            FontSize="Small" HorizontalTextAlignment="Justify"
                            TextColor="{DynamicResource Gray500}" />
                    </VerticalStackLayout>
                    <Switch
                        Grid.Column="1"
                        VerticalOptions="Center" OffColor="{DynamicResource Gray700}"
                        IsToggled="{Binding ProgressCardEnabled, Mode=TwoWay}"
                        OnColor="{DynamicResource Gray300}"
                        ThumbColor="{StaticResource White}" />
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray700}" Margin="0,8"/>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label
                            Text="Rest Stopwatch" FontSize="Medium" />
                        <Label
                            Text="Track rest time between sets with a stopwatch during your workout."
                            FontSize="Small" HorizontalTextAlignment="Justify"
                            TextColor="{DynamicResource Gray500}" />
                    </VerticalStackLayout>
                    <Switch
                        Grid.Column="1"
                        VerticalOptions="Center" OffColor="{DynamicResource Gray700}"
                        IsToggled="{Binding RestStopwatchEnabled, Mode=TwoWay}"
                        OnColor="{DynamicResource Gray300}"
                        ThumbColor="{StaticResource White}" />
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray700}" Margin="0,8"/>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label
                            Text="Auto-Start Rest" FontSize="Medium" />
                        <Label
                            Text="Automatically restart the rest stopwatch when you finish an exercise."
                            FontSize="Small" HorizontalTextAlignment="Justify"
                            TextColor="{DynamicResource Gray500}" />
                    </VerticalStackLayout>
                    <Switch
                        Grid.Column="1"
                        IsEnabled="{Binding RestStopwatchEnabled}"
                        VerticalOptions="Center" OffColor="{DynamicResource Gray700}"
                        IsToggled="{Binding AutoStartRestOnExerciseFinish, Mode=TwoWay}"
                        OnColor="{DynamicResource Gray300}"
                        ThumbColor="{StaticResource White}" />
                </Grid>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray700}" Margin="0,8"/>

            <VerticalStackLayout x:Name="VoiceLoggingSection" Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label
                            Text="Voice Logging" FontSize="Medium" />
                        <Label
                            Text="Show a microphone button on the workout page to log sets by voice. Say the exercise, the weight and the reps."
                            FontSize="Small" HorizontalTextAlignment="Justify"
                            TextColor="{DynamicResource Gray500}" />
                    </VerticalStackLayout>
                    <Switch
                        Grid.Column="1"
                        VerticalOptions="Center" OffColor="{DynamicResource Gray700}"
                        IsToggled="{Binding VoiceLoggingEnabled, Mode=TwoWay}"
                        OnColor="{DynamicResource Gray300}"
                        ThumbColor="{StaticResource White}" />
                </Grid>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray700}" Margin="0,8"/>

            <VerticalStackLayout x:Name="HeatmapSection" Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label
                            Text="Start Week on Monday" FontSize="Medium" />
                        <Label
                            Text="Disable to start your week on Sunday instead."
                            FontSize="Small" HorizontalTextAlignment="Justify"
                            TextColor="{DynamicResource Gray500}" />
                    </VerticalStackLayout>
                    <Switch
                        Grid.Column="1"
                        VerticalOptions="Center" OffColor="{DynamicResource Gray700}"
                        IsToggled="{Binding HeatmapWeekStartsOnMonday, Mode=TwoWay}"
                        OnColor="{DynamicResource Gray300}"
                        ThumbColor="{StaticResource White}" />
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource Gray700}" Margin="0,8"/>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label
                            Text="GitHub-Style Heatmap" FontSize="Medium" />
                        <Label
                            Text="Show the heatmap as 7 rows of weekdays with weeks running left to right, like GitHub's contribution graph."
                            FontSize="Small" HorizontalTextAlignment="Justify"
                            TextColor="{DynamicResource Gray500}" />
                    </VerticalStackLayout>
                    <Switch
                        Grid.Column="1"
                        VerticalOptions="Center" OffColor="{DynamicResource Gray700}"
                        IsToggled="{Binding HeatmapGitHubStyle, Mode=TwoWay}"
                        OnColor="{DynamicResource Gray300}"
                        ThumbColor="{StaticResource White}" />
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>