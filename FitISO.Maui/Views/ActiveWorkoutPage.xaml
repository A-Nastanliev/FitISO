<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitISO.Maui.Views.ActiveWorkoutPage"
             xmlns:local="clr-namespace:FitISO.Maui"
             Title="Active">
    <VerticalStackLayout>
        <Button Text="Start Workout"
                Clicked="ToggleActiveWorkoutClicked">
            <Button.Triggers>
                <DataTrigger TargetType="Button"
                             Binding="{Binding Source={x:Static local:ActiveWorkoutState.Instance}, Path=HasActiveWorkout}"
                             Value="True">
                    <Setter Property="Text" Value="End Workout" />
                </DataTrigger>
            </Button.Triggers>
        </Button>
    </VerticalStackLayout>
</ContentPage>