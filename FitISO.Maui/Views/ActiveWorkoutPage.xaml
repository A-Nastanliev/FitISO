<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitISO.Maui.Views.ActiveWorkoutPage"
             xmlns:local="clr-namespace:FitISO.Maui"
             local:AppShellTabBar.Command="{Binding AddExerciseCommand}"
             local:AppShellTabBar.CommandParameter="{x:Null}"
             local:AppShellTabBar.Icon="&#xE145;"
             xmlns:vm="clr-namespace:FitISO.Maui.ViewModels"
             xmlns:models="clr-namespace:FitISO.Maui.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:FitISO.Maui.Views"
             x:DataType="vm:ActiveWorkoutViewModel"
             x:Name="Root"
             Title="Active">

    <Shell.TitleView>
        <Grid Padding="0" RowDefinitions="Auto,Auto" RowSpacing="4">
            <Grid Grid.Row="0" ColumnDefinitions="auto,*,auto" ColumnSpacing="10" Padding="10,0">
                <Label Text="{Binding Duration, StringFormat='{0:hh\\:mm\\:ss}'}" Grid.Column="0" FontSize="Medium" VerticalOptions="Center" VerticalTextAlignment="Center"/>
                <Entry Grid.Column="1" Text="{Binding Workout.Name, Mode=TwoWay}" FontSize="Medium" MaxLength="40" HorizontalOptions="Fill" MinimumWidthRequest="60"
                FontAttributes="Bold" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                <ImageButton Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xEAF8;'}" 
                    Command="{Binding FinishWorkoutCommand}" Grid.Column="2" VerticalOptions="Center"/>
            </Grid>
            <ProgressBar Grid.Row="1" Progress="{Binding Progress}" ProgressColor="{StaticResource Gray100}" HeightRequest="4"
                BackgroundColor="{StaticResource Gray600}"/>
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout>
            <CollectionView VerticalOptions="Fill"  AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All"
                ItemsSource="{Binding Workout.WorkoutExercises}" Margin="0,6,0,6" SelectionMode="None" VerticalScrollBarVisibility="Never">

                <CollectionView.ItemTemplate>
                    <DataTemplate  x:DataType="models:WorkoutExercise">
                        <Grid Margin="8,16">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="" BackgroundColor="Transparent"
                                             Command="{Binding BindingContext.DecreaseSetsCommand, Source={x:Reference Root}}"
                                             CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <SwipeView.LeftItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="" BackgroundColor="Transparent"
                                             Command="{Binding BindingContext.IncreaseSetsCommand, Source={x:Reference Root}}"
                                             CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.LeftItems>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 25" BackgroundColor="{StaticResource Gray800}" x:Name="OuterBorder">
                                    <Grid Padding="0" RowDefinitions="Auto, Auto, Auto" RowSpacing="0">
                                        <Label HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                                           Text="{Binding Exercise.Name}" FontSize="Medium" Padding="0,4"/>
                                        <Border Grid.Row="1" StrokeShape="RoundRectangle 25" StrokeThickness="0"
                                            IsVisible="{Binding Exercise.VisibleSets}" Stroke="Transparent">
                                            <toolkit:Expander>
                                                <toolkit:Expander.Header>
                                                    <Grid RowDefinitions="Auto, Auto" BackgroundColor="{StaticResource Gray200}">
                                                        <Border HorizontalOptions="Center" StrokeShape="RoundRectangle 25"
                                                            BackgroundColor="{StaticResource Gray500}" StrokeThickness="0"
                                                            Padding="4,0" Margin="0,2" Grid.Row="0">
                                                            <Label Text="PERSONAL RECORD" Margin="4,0" VerticalOptions="Center"
                                                               VerticalTextAlignment="Center" TextColor="{StaticResource Gray200}"
                                                               FontAttributes="Bold" HorizontalOptions="Center" FontSize="Small"/>
                                                        </Border>
                                                        <Grid Margin="0,0,30,0" Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="12" VerticalOptions="Center">
                                                            <Grid Grid.Column="0" ColumnSpacing="8" HorizontalOptions="Center"
                                                                IsClippedToBounds="True" ColumnDefinitions="5*,auto,4*">
                                                                <Label Text="{Binding Exercise.BestSet.Weight, StringFormat='{0:0.##}'}"
                                                                   TextColor="{StaticResource Gray800}" HorizontalOptions="Fill"
                                                                   HorizontalTextAlignment="End" FontSize="Small" MinimumWidthRequest="90"/>
                                                                <Label Text="kg" VerticalTextAlignment="Center" Grid.Column="1"
                                                                    FontSize="Small" TextColor="{StaticResource Gray800}"/>
                                                            </Grid>
                                                            <Label Text="{Binding Exercise.BestSet.Reps, StringFormat='{0:0.##}'}"
                                                                 Grid.Column="1" TextColor="{StaticResource Gray800}" MinimumWidthRequest="90"
                                                                 HorizontalOptions="Center" HorizontalTextAlignment="End" FontSize="Small"/>
                                                        </Grid>
                                                    </Grid>
                                                </toolkit:Expander.Header>

                                                <toolkit:Expander.Content>
                                                    <Grid RowDefinitions="Auto,Auto" BackgroundColor="{StaticResource Gray500}">
                                                        <Border HorizontalOptions="Center" StrokeShape="RoundRectangle 25"
                                                            BackgroundColor="{StaticResource Gray200}" StrokeThickness="0"
                                                            Padding="4,0" Margin="0,2" Grid.Row="0">
                                                            <Label Text="{Binding Exercise.LastSetsDate, Converter={StaticResource DateConverter}}"
                                                               Margin="4,0" VerticalOptions="Center" VerticalTextAlignment="Center"
                                                               TextColor="{StaticResource Gray500}" HorizontalOptions="Center"
                                                               FontAttributes="Bold" FontSize="Small"/>
                                                        </Border>
                                                        <CollectionView ItemsSource="{Binding Exercise.LastSets}" Grid.Row="1">
                                                            <CollectionView.ItemTemplate>
                                                                <DataTemplate x:DataType="models:Set">
                                                                    <Grid Margin="0,0,30,0" Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="12" VerticalOptions="Center">
                                                                        <Grid Grid.Column="0" ColumnSpacing="8" HorizontalOptions="Center"
                                                                            IsClippedToBounds="True" ColumnDefinitions="5*,auto,4*">
                                                                            <Label Text="{Binding Weight, StringFormat='{0:0.##}'}"
                                                                                  TextColor="{StaticResource Gray800}" HorizontalOptions="Fill"
                                                                                  HorizontalTextAlignment="End" FontSize="Small" MinimumWidthRequest="90"/>
                                                                            <Label Text="kg" VerticalTextAlignment="Center" Grid.Column="1"
                                                                                FontSize="Small" TextColor="{StaticResource Gray800}"/>
                                                                        </Grid>
                                                                        <Label Text="{Binding Reps, StringFormat='{0:0.##}'}"
                                                                            Grid.Column="1" TextColor="{StaticResource Gray800}" MinimumWidthRequest="90"
                                                                            HorizontalOptions="Center" HorizontalTextAlignment="End" FontSize="Small"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </CollectionView.ItemTemplate>
                                                        </CollectionView>
                                                    </Grid>
                                                </toolkit:Expander.Content>
                                            </toolkit:Expander>
                                        </Border>
                                        <CollectionView VerticalOptions="Fill"  AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All"
                                            ItemsSource="{Binding Sets}" Margin="0" SelectionMode="None" VerticalScrollBarVisibility="Never" Grid.Row="2">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="models:Set">
                                                    <Grid RowDefinitions="Auto, Auto">
                                                        <BoxView HeightRequest="1" Color="{StaticResource Gray600}"/>
                                                        <Grid Margin="0,0,30,0" Grid.Row="1" ColumnDefinitions="3* , 2*" ColumnSpacing="12" VerticalOptions="Center">
                                                            <Grid Grid.Column="0" ColumnSpacing="8" HorizontalOptions="Center" 
                                                              IsClippedToBounds="True" ColumnDefinitions="5*,auto,4*">
                                                                <BoxView Color="{Binding BackgroundColor, Source={x:Reference OuterBorder}}"  />
                                                                <Entry   Text="{Binding Weight, StringFormat='{0:0.##}', Mode=TwoWay, 
                                                                   Converter={StaticResource NullableDoubleConverter}}"  Keyboard="Numeric" MaxLength="7" 
                                                                   PlaceholderColor="{StaticResource Gray400}" Placeholder="W" MinimumWidthRequest="90"
                                                                   HorizontalOptions="Fill" HorizontalTextAlignment="End" FontSize="Small"/>
                                                                <Label Text="kg" FontSize="Small" VerticalTextAlignment="Center" Grid.Column="1"/>
                                                            </Grid>
                                                            <Entry  Text="{Binding Reps, StringFormat='{0:0.##}', Mode=TwoWay, 
                                                               Converter={StaticResource NullableDoubleConverter}}"  Keyboard="Numeric" Grid.Column="1" MaxLength="5" 
                                                               HorizontalOptions="Center" HorizontalTextAlignment="End" FontSize="Small" MinimumWidthRequest="90"
                                                               PlaceholderColor="{StaticResource Gray400}" Placeholder="R"/>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>