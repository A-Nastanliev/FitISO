<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitISO.Maui.Views.ActiveWorkoutPage"
             xmlns:local="clr-namespace:FitISO.Maui"
             xmlns:vm="clr-namespace:FitISO.Maui.ViewModels"
             xmlns:models="clr-namespace:FitISO.Maui.Models"
             xmlns:views="clr-namespace:FitISO.Maui.Views"
             x:DataType="vm:ActiveWorkoutViewModel"
             x:Name="Root"
             Title="Active">

    <Shell.TitleView>
        <Grid Padding="10,0" ColumnDefinitions="auto, *,auto" ColumnSpacing="10">
            <Label Text="{Binding Duration, StringFormat='{0:hh\\:mm\\:ss}'}" Grid.Column="0" FontSize="Medium" VerticalOptions="Center" VerticalTextAlignment="Center"/>
            <Entry Grid.Column="1" Text="{Binding Workout.Name, Mode=TwoWay}" FontSize="Medium"
                FontAttributes="Bold" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
            <ImageButton Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xEAF8;'}" 
                Command="{Binding AddExerciseCommand}" Grid.Column="2" VerticalOptions="Center"/>
        </Grid>
    </Shell.TitleView>

    <ScrollView> 
        <VerticalStackLayout>
            <CollectionView VerticalOptions="Fill"  AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All"
                ItemsSource="{Binding Workout.WorkoutExercises}" Margin="0,6,0,6" SelectionMode="None" VerticalScrollBarVisibility="Never">

                <CollectionView.ItemTemplate>
                    <DataTemplate  x:DataType="models:WorkoutExercise">
                        <Grid Margin="8,16">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="" BackgroundColor="Transparent"
                                             Command="{Binding BindingContext.DecreaseSetsCommand, Source={x:Reference Root}}"
                                             CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <SwipeView.LeftItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="" BackgroundColor="Transparent"
                                             Command="{Binding BindingContext.IncreaseSetsCommand, Source={x:Reference Root}}"
                                             CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.LeftItems>
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 25" BackgroundColor="{StaticResource Gray800}" x:Name="OuterBorder">
                                    <Grid Padding="0" RowDefinitions="Auto, Auto" RowSpacing="6">
                                        <Label HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                                           Text="{Binding Exercise.Name}" FontSize="Medium" Padding="0,4"/>
                                        <CollectionView VerticalOptions="Fill"  AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All"
                                        ItemsSource="{Binding Sets}" Margin="0" SelectionMode="None" VerticalScrollBarVisibility="Never" Grid.Row="1">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="models:Set">
                                                    <Grid RowDefinitions="Auto, Auto">
                                                        <BoxView HeightRequest="1" Color="{StaticResource Gray600}"/>
                                                        <Grid Margin="30,0" Grid.Row="1" ColumnDefinitions="65* , 35*" ColumnSpacing="24" VerticalOptions="Center">
                                                            <Grid Grid.Column="0" ColumnSpacing="8" HorizontalOptions="Fill" 
                                                              IsClippedToBounds="True" ColumnDefinitions="5*,auto,4*">
                                                                <BoxView Color="{Binding BackgroundColor, Source={x:Reference OuterBorder}}"  />
                                                                <Entry Text="{Binding Weight, Mode=TwoWay}" Keyboard="Numeric" MaxLength="7" 
                                                                   PlaceholderColor="{StaticResource Gray400}" Placeholder="W"
                                                                   HorizontalOptions="Fill" HorizontalTextAlignment="End" FontSize="Small"/>
                                                                <Label Text="kg" VerticalTextAlignment="Center" Grid.Column="1"/>
                                                            </Grid>
                                                            <Entry Text="{Binding Reps, Mode=TwoWay}" Keyboard="Numeric" Grid.Column="1" MaxLength="5"
                                                               HorizontalOptions="Center" HorizontalTextAlignment="End" FontSize="Small"
                                                                PlaceholderColor="{StaticResource Gray400}" Placeholder="R"/>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
            <ImageButton Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE145;'}" BackgroundColor="{StaticResource Gray800}"
                HorizontalOptions="Center" Margin="10" HeightRequest="50" WidthRequest="50" CornerRadius="25"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>