<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mhr="http://mhrastegari.com/progressring"
             xmlns:vm="clr-namespace:FitISO.Maui.ViewModels"
             x:Class="FitISO.Maui.Views.WorkoutRingView"
             x:DataType="vm:ActiveWorkoutViewModel"
             xmlns:behaviors="clr-namespace:FitISO.Maui.Behaviors"
             IsVisible="{Binding IsRingLayout}">

    <Grid ColumnDefinitions="*,Auto,*">

        <Grid Grid.Column="1" WidthRequest="220" HeightRequest="220" x:Name="Dial">
            <Ellipse Fill="{DynamicResource Gray800}" />

            <mhr:ProgressRing WidthRequest="220" HeightRequest="220"
                HorizontalOptions="Center" VerticalOptions="Center"
                StrokeThickness="14" Progress="{Binding DisplayProgress}"
                ProgressColor="{DynamicResource Gray100}"
                TrackColor="{DynamicResource Gray600}"
                IsVisible="{Binding ShowProgressCard}">
                <mhr:ProgressRing.Behaviors>
                    <behaviors:AnimatedProgressRingBehavior
                        TargetProgress="{Binding DisplayProgress}" Duration="300"
                        DefaultColorKey="Gray100" CompletedColorKey="ChartAccentColor"
                        PulseTarget="{x:Reference Dial}" />
                </mhr:ProgressRing.Behaviors>
            </mhr:ProgressRing>

            <Grid RowDefinitions="3*,2*" Margin="24">
                <Label Grid.Row="0" VerticalOptions="End"
                       Text="{Binding DisplayDuration, StringFormat='{0:hh\\:mm\\:ss}'}"
                       FontSize="34" FontAttributes="Bold" TextColor="White"
                       HorizontalTextAlignment="Center" />

                <VerticalStackLayout Grid.Row="1" x:Name="RestTimer" x:DataType="vm:RestStopwatchViewModel"
                                     VerticalOptions="Start" IsVisible="{Binding IsAvailable}">
                    <Label Text="{Binding Elapsed, StringFormat='{0:mm\\:ss}'}"
                           FontSize="Large" TextColor="{DynamicResource Gray400}"
                           HorizontalTextAlignment="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsStopped}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsStopped}" Value="False">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding ShowStart}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <VerticalStackLayout Grid.Column="2" x:Name="RestControls" x:DataType="vm:RestStopwatchViewModel"
                             Spacing="12" HorizontalOptions="Center" VerticalOptions="Center"
                             IsVisible="{Binding IsAvailable}">
            <ImageButton HeightRequest="50" WidthRequest="50" CornerRadius="25" Padding="8"
                         BackgroundColor="{DynamicResource Gray600}"
                         Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE037;', Color=White, Size=18}"
                         IsVisible="{Binding ShowStart}" Command="{Binding StartCommand}" />

            <ImageButton HeightRequest="50" WidthRequest="50" CornerRadius="25" Padding="8"
                         BackgroundColor="{DynamicResource DeleteColor}"
                         Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE047;', Color=White, Size=18}"
                         IsVisible="{Binding ShowRunning}" Command="{Binding StopCommand}" />

            <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowStopped}">
                <ImageButton HeightRequest="50" WidthRequest="50" CornerRadius="25" Padding="8"
                             BackgroundColor="{DynamicResource Gray600}"
                             Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE037;', Color=White, Size=18}"
                             Command="{Binding ResumeCommand}" />
                <ImageButton HeightRequest="50" WidthRequest="50" CornerRadius="25" Padding="8"
                             BackgroundColor="{DynamicResource Gray500}"
                             Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE5D5;', Color=White, Size=18}"
                             Command="{Binding RestartCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentView>