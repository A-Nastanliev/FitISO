<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitISO.Maui.Views.WorkoutTemplatesPage"
             xmlns:local="clr-namespace:FitISO.Maui"
             xmlns:vm="clr-namespace:FitISO.Maui.ViewModels"
             xmlns:models="clr-namespace:FitISO.Maui.Models"
             x:DataType="vm:WorkoutTemplatesViewModel"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:FitISO.Maui.Views"
             x:Name="Root"
             local:AppShellTabBar.Command="{Binding AddWorkoutTemplateCommand}"
             local:AppShellTabBar.CommandParameter="{x:Null}"
             local:AppShellTabBar.Icon="&#xE145;"
             Title="Workouts">

    <Shell.TitleView>
        <Label Text="Workouts" FontSize="Medium" FontAttributes="Bold" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
    </Shell.TitleView>

    <Grid RowDefinitions="*"  SafeAreaEdges="None">
        <CollectionView VerticalOptions="Fill"  ItemsSource="{Binding Items}" Margin="6,0,6,6" SelectionMode="None"
                        RemainingItemsThreshold="3" VerticalScrollBarVisibility="Never"
                        RemainingItemsThresholdReachedCommand="{Binding LoadCommand}">

            <CollectionView.Footer>
                <BoxView HeightRequest="100" Color="Transparent" BackgroundColor="Transparent" Background="Transparent"/>
            </CollectionView.Footer>

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Image HorizontalOptions="Center"
                        Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE3C9;', Size=48, Color={DynamicResource Gray500}}"/>
                    <Label Text="No workouts yet" FontSize="Medium" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <Label Text="Tap + to create your first template" TextColor="{DynamicResource Gray400}" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Workout">
                    <Border Style="{StaticResource SectionCard}" Margin="8,6" Padding="16,14">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="Medium" FontAttributes="Bold"
                                        LineBreakMode="TailTruncation" MaxLines="1"/>
                                    <Label Text="{Binding WorkoutExercises.Count, StringFormat='{0} exercises'}"
                                        FontSize="Micro" TextColor="{DynamicResource Gray400}"/>
                                </VerticalStackLayout>

                                <ImageButton Grid.Column="1" BackgroundColor="Transparent" Aspect="Center"
                                     VerticalOptions="Start"
                                     Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE83A;', Size=22, Color={DynamicResource Gray400}}"
                                     Command="{Binding BindingContext.ToggleFavoriteCommand, Source={x:Reference Root}}"
                                     CommandParameter="{Binding .}">
                                    <ImageButton.Triggers>
                                        <DataTrigger TargetType="ImageButton" Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Source"
                                                Value="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE838;', Size=22, Color={DynamicResource ChartAccentColor}}"/>
                                        </DataTrigger>
                                    </ImageButton.Triggers>
                                </ImageButton>
                            </Grid>

                            <VerticalStackLayout Grid.Row="1" Spacing="0" BindableLayout.ItemsSource="{Binding WorkoutExercises}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkoutExercise">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="0,6">
                                            <Label Text="{Binding Exercise.Name}" FontSize="Small"
                                                LineBreakMode="TailTruncation" MaxLines="1"/>
                                            <Label Grid.Column="1" Text="{Binding SetCount, StringFormat='{0}'}"
                                                FontSize="Small" TextColor="{DynamicResource Gray400}"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <BoxView Grid.Row="2" HeightRequest="1" Margin="0,4,0,0"
                                Color="{DynamicResource Gray700}"/>

                            <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
                                <ImageButton BackgroundColor="Transparent" Aspect="Center"
                                     Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE3C9;', Size=22, Color={DynamicResource Gray300}}"
                                     Command="{Binding BindingContext.EditWorkoutTemplateCommand, Source={x:Reference Root}}"
                                     CommandParameter="{Binding .}"/>
                                <ImageButton Grid.Column="1" BackgroundColor="Transparent" Aspect="Center"
                                     Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE872;', Size=22, Color={DynamicResource Gray400}}"
                                     Command="{Binding BindingContext.DeleteWorkoutTemplateCommand, Source={x:Reference Root}}"
                                     CommandParameter="{Binding .}"/>
                                <ImageButton Grid.Column="2" BackgroundColor="{DynamicResource ChartAccentColor}" Aspect="Center" HorizontalOptions="End"
                                  CornerRadius="16" Padding="6" Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE037;', Size=22, Color={DynamicResource Gray950}}"
                                  Command="{Binding BindingContext.StartWorkoutCommand, Source={x:Reference Root}}"
                                  CommandParameter="{Binding .}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>