<?xml version="1.0" encoding="utf-8" ?>
<nlayouts:PopupPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:nlayouts="https://nalu-development.github.com/nalu/layouts"
             xmlns:vm="clr-namespace:FitISO.Maui.ViewModels"
             x:Class="FitISO.Maui.Views.AddExercisePopupPage"
             xmlns:local="clr-namespace:FitISO.Maui"
             local:AppShellTabBar.Icon="&#xE145;"
             x:DataType="vm:AddExercisePopupViewModel"
             CloseOnScrimTapped="True">

    <nlayouts:PopupPageBase.Resources>
        <Style TargetType="nlayouts:PopupContainer">
            <Setter Property="Background" Value="{DynamicResource Gray800}" />
            <Setter Property="Margin" Value="16" />
            <Setter Property="StrokeShape" Value="RoundRectangle 24" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>
    </nlayouts:PopupPageBase.Resources>

    <Grid Padding="20" RowSpacing="12" RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*">
        <Label Text="New exercise" Grid.ColumnSpan="2" Grid.Row="0"
               FontSize="Medium"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <VerticalStackLayout Grid.ColumnSpan="2" Grid.Row="1" HorizontalOptions="Fill"> 
            <Entry Placeholder="e.g Bench press" 
               Text="{Binding Name}" MaxLength="100" Keyboard="Default" FontSize="Small" />
            <BoxView HeightRequest="1" Color="{DynamicResource Gray600}"/>
        </VerticalStackLayout>

        <Grid ColumnDefinitions="*,*" Grid.Row="2" ColumnSpacing="24">
            <Button Text="Cancel" BackgroundColor="{DynamicResource Gray600}" TextColor="{DynamicResource Gray200}" FontSize="Small"
                    Command="{Binding CancelCommand}" CornerRadius="20" Grid.Column="0"/>
            <Button Text="Add" CornerRadius="20" Grid.Column="1" FontSize="Small"
                    Command="{Binding AddCommand}" BackgroundColor="{DynamicResource Gray500}" TextColor="White"/>
        </Grid>
    </Grid>
</nlayouts:PopupPageBase>