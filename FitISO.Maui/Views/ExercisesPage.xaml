<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitISO.Maui.Views.ExercisesPage"
             xmlns:vm="clr-namespace:FitISO.Maui.ViewModels"
             x:DataType="vm:ExercisePageViewModel"
             xmlns:views="clr-namespace:FitISO.Maui.Views"
             xmlns:local="clr-namespace:FitISO.Maui"
             local:AppShellTabBar.Command="{Binding AddExerciseCommand}"
             local:AppShellTabBar.CommandParameter="{x:Null}"
             local:AppShellTabBar.Icon="&#xE145;"
             Shell.NavBarIsVisible="True">

    <Shell.TitleView>
        <Label Text="Exercises" FontSize="Medium" FontAttributes="Bold" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
    </Shell.TitleView>

    <AbsoluteLayout>
        <ScrollView VerticalScrollBarVisibility="Never" HorizontalOptions="Fill" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
            <CollectionView VerticalOptions="Fill" 
                        ItemsSource="{Binding ExerciseCollection.Exercises}" Margin="6" SelectionMode="Single" SelectedItem="{Binding SelectedExercise, Mode=TwoWay}"
                        RemainingItemsThreshold="3" VerticalScrollBarVisibility="Never"
                        RemainingItemsThresholdReachedCommand="{Binding ExerciseCollection.LoadCommand}">

                <CollectionView.EmptyView>
                    <Label  Text="No exercises found"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <views:ExerciseView
                                x:DataType="views:ExerciseView" Margin="0,4" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </ScrollView>
    </AbsoluteLayout>
</ContentPage>