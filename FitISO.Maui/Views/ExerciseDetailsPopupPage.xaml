<?xml version="1.0" encoding="utf-8" ?>
<nlayouts:PopupPageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:nlayouts="https://nalu-development.github.com/nalu/layouts"
             xmlns:vm="clr-namespace:FitISO.Maui.ViewModels"
             x:Class="FitISO.Maui.Views.ExerciseDetailsPopupPage"
             x:DataType="vm:ExerciseDetailsPopupViewModel"
             CloseOnScrimTapped="True">

    <nlayouts:PopupPageBase.Resources>
        <Style TargetType="nlayouts:PopupContainer">
            <Setter Property="Background" Value="{StaticResource Gray800}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 24,24,0,0" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="VerticalOptions" Value="End" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>
    </nlayouts:PopupPageBase.Resources>

    <Grid Padding="20" RowSpacing="12" ColumnDefinitions="*, auto, auto" ColumnSpacing="12">

        <Label Text="{Binding Exercise.Name}" Grid.Row="0" Grid.Column="0"
           FontSize="Medium" VerticalOptions="Center" FontAttributes="Bold"
           HorizontalOptions="Start" IsVisible="{Binding IsNotEditingName}" />

        <Entry Text="{Binding Exercise.Name}" Grid.Row="0" Grid.Column="0"
           FontSize="Medium" FontAttributes="Bold"
           IsVisible="{Binding IsEditingName}"
           ReturnCommand="{Binding SaveRenameCommand}" />

        <ImageButton Grid.Row="0" Grid.Column="1" HeightRequest="48" WidthRequest="48"
                 Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE3C9;'}" CornerRadius="24" Padding="8"
                 IsVisible="{Binding IsNotEditingName}"  BackgroundColor="{StaticResource Gray500}" 
                 Command="{Binding StartRenameCommand}" />

        <ImageButton Grid.Row="0" Grid.Column="1" HeightRequest="48" WidthRequest="48"
                 Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE5C9;'}" 
                 BackgroundColor="Transparent"   CornerRadius="24" Padding="-4"
                 IsVisible="{Binding IsEditingName}"
                 Command="{Binding CancelRenameCommand}" IsEnabled="{Binding IsNotBusy}" />

        <ImageButton Grid.Row="0" Grid.Column="2" HeightRequest="48" WidthRequest="48"
                 Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE872;'}" BackgroundColor="IndianRed"
                 CornerRadius="24" Padding="8"
                 IsVisible="{Binding ShowDeleteButton}"
                 Command="{Binding DeleteCommand}" IsEnabled="{Binding IsNotBusy}" />

        <ImageButton Grid.Row="0" Grid.Column="2" HeightRequest="48" WidthRequest="48"
                 Source="{FontImageSource FontFamily=MaterialRound, Glyph='&#xE876;'}"
                 BackgroundColor="{StaticResource Gray500}"  CornerRadius="24" Padding="8"
                 IsVisible="{Binding IsEditingName}" 
                 Command="{Binding SaveRenameCommand}" IsEnabled="{Binding IsNotBusy}" />
    </Grid>
</nlayouts:PopupPageBase>